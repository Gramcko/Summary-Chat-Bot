# Base URL of the Summarly backend API (server-side only).
# The browser never talks to this origin directly: the dashboard proxies
# /api/* to it, so the httpOnly session cookie stays same-origin.
BACKEND_URL=http://127.0.0.1:3000

# Development only: comma-separated hosts allowed to use the Next.js dev
# server (HMR) from other devices, e.g. your LAN IP. Next 16 blocks unknown
# origins by default. Create dashboard/.env.local (gitignored) with your
# actual address; this file only documents the variable.
# NEXT_ALLOWED_DEV_ORIGINS=192.168.1.100
