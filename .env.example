# Summarly Chat Bot — environment variables (safe placeholders only).
# Copy to .env AT THE REPOSITORY ROOT (never commit .env). Every backend
# entry point (server, migrations, reset-password) loads it automatically
# from there; variables already set in the shell take precedence.

# Backend HTTP port.
PORT=3000

# Bind address. Keep 127.0.0.1 for a local install; use 0.0.0.0 inside containers.
HOST=127.0.0.1

# Set to true when the dashboard is served over HTTPS.
COOKIE_SECURE=false

# PostgreSQL connection string (see docker-compose.dev.yml for local dev).
DATABASE_URL=postgres://summarly:summarly_dev_password@127.0.0.1:5432/summarly

# Master key for encrypting stored AI provider credentials (AES-256-GCM).
# Must be base64 for exactly 32 random bytes. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep it outside the database and never commit the real value. Losing it
# makes saved provider keys unrecoverable (they must be re-entered).
ENCRYPTION_KEY=replace-me-with-base64-encoded-32-random-bytes

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For
# header is trusted for client-IP derivation (rate limiting). Default:
# loopback only (covers a local dashboard proxy). Never add an untrusted
# address — it would let clients pick their own lockout bucket.
TRUSTED_PROXIES=127.0.0.1,::1

# Redis connection string for BullMQ queue state (summary jobs; see
# docker-compose.dev.yml). Queue state only — PostgreSQL remains the
# source of truth for messages, runs, and summaries. If your Redis
# requires a password, put it in the URL and never commit the real value.
REDIS_URL=redis://127.0.0.1:6379

# summary-worker: how many summary jobs run in parallel (integer 1-16).
# Keep it modest: every job may call the AI provider.
SUMMARY_CONCURRENCY=2

# Producer-side knob (the BACKEND enqueuer reads it; the retry policy is
# stored on each job at enqueue time): base delay in milliseconds for the
# exponential retry backoff of summary jobs (each failed attempt waits
# longer than the previous one). Lower it only for tests.
SUMMARY_RETRY_BASE_MS=30000

# BullMQ key-prefix namespace for the summary queue (all queue keys are
# namespaced with it). Keep the default for deployments; test suites use
# "summarly-test" and the end-to-end check "summarly-e2e" so they can
# share a Redis with a running instance without stealing its jobs.
SUMMARY_QUEUE_PREFIX=summarly

# How often the backend re-checks summary runs that lost their queue job
# (milliseconds, integer >= 1000; values below 1000 are raised to 1000).
RECONCILE_INTERVAL_MS=60000
