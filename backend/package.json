{
  "name": "@summarly/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --fileParallelism=false",
    "test:integration": "tsx scripts/require-test-db.ts && vitest run --fileParallelism=false",
    "migrate": "tsx scripts/migrate.ts",
    "reset-password": "tsx scripts/reset-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.0",
    "@summarly/contracts": "*",
    "bullmq": "^6.5.2",
    "fastify": "^5.12.0",
    "ioredis": "^5.11.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
